# Waveshare ESP32-P4-WIFI6-Touch-LCD-7B 板级默认配置
# 参考: esp32p4_research/ESP32-P4-WIFI6-Touch-LCD-7B/examples/ESP-IDF/*/sdkconfig.defaults
#
# 注意: 厂家示例是用 ESP-IDF 5.4.0 生成的; 本项目使用 ESP-IDF 5.4.3。
#       5.4.3 中 200MHz PSRAM 依赖 IDF_EXPERIMENTAL_FEATURES，故一并打开。

CONFIG_IDF_TARGET="esp32p4"

# ---- Flash ----
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_SPI_FLASH_SUPPORT_GD_CHIP=y

# ---- PSRAM ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# ---- Cache ----
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# ---- 分区表 (自定义, 见同目录 partitions.csv) ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- IDF 5.4.3: 200MHz PSRAM 需要打开实验特性才可见 ----
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# ---- LVGL ----
# LVGL 默认 LV_USE_OS = NONE（无线程安全），必须选 FreeRTOS
# LVGL 相关：main 任务里会创建界面对象，栈给足；提高 tick 精度改善刷新/动画
CONFIG_LV_OS_FREERTOS=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_FREERTOS_HZ=1000

# 内存/字符串/格式化统一走 C 库（即 ESP-IDF 的堆），厂家 LVGL 示例同样配置
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15

# 全局默认字体。全项目代码里一处都没设过字体（都用继承），所以所有文字
# 吃的都是这一项 —— 改这里 = 全项目字号一起变。
# 18 号字体由这个 choice 自动 select 进来（Kconfig 里的 select LV_FONT_MONTSERRAT_18）。
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_18=y

# ---- 全量字体档位 8~48（一次开满，以后写 UI 想用哪档用哪档）----
# 决策：把 LVGL 预置的 Montserrat 档位全部打开，从此不必"用一种开一种"。
#       需要某档时直接在代码里 lv_obj_set_style_text_font() 即可。
#
# 为什么选"开满位图档位"而不是"运行时 TTF (LV_USE_TINY_TTF)"：
#   - 位图档位是纯 rodata：**零运行期 RAM、零 CPU 开销、零新机制**。
#   - tiny_ttf 要引入字体对象的创建/缓存/销毁，以及每档一份字形缓存
#     （48px 默认缓存约 100~130 KB 内部 RAM），运行期复杂度更高。
#   - 实测全梯 rodata ≈ 846 KB；app 分区 8 MB、当前固件 2.74 MB，余量充足。
#     （对照：tiny_ttf = 代码 21.6 KB + Montserrat TTF 238 KB ≈ 259 KB，
#       换来"任意字号"；本方案只到 48。约 6 档以内位图更省，此处选确定性。）
#
# ⚠️ 上限：LVGL 预置的 Montserrat 最大就是 48，没有 64/72/96。
#    将来真要 >48px，三条路：
#      ① transform_scale 放大 48（位图拉伸，发虚/锯齿）；
#      ② 用 managed_components/lvgl__lvgl/scripts/built_in_font 的 lv_font_conv
#         离线生成某个大号的 .c 提交（仍属本方案，清晰、零运行期成本）；
#      ③ 上 tiny_ttf。
#
# ⚠️ 生效方式：defaults 只对 sdkconfig 里"尚未出现"的符号生效。这些档位在
#    现有 sdkconfig 里已是 "# ... is not set"，故改完必须删掉 sdkconfig 重新生成
#    （sdkconfig 未纳入 git，可安全删除）。
CONFIG_LV_FONT_MONTSERRAT_8=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_30=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_34=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_38=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_42=y
CONFIG_LV_FONT_MONTSERRAT_44=y
CONFIG_LV_FONT_MONTSERRAT_46=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# ---- 中文字体（components/font_cjk）需要的两项 ----
#
# 1) LV_USE_FONT_COMPRESSED —— **不开就会"中文一片空白"**
#    lv_font_conv 默认输出 RLE **压缩**格式的位图（生成物里 .bitmap_format = 1）。
#    LVGL 的压缩解码器默认关闭（Kconfig 里这个 bool 没有 default，即默认 n），
#    于是 lv_font_get_bitmap_fmt_txt() 会走到这个分支直接返回：
#        lv_font_fmt_txt.c:  #else /*!LV_USE_FONT_COMPRESSED*/ ... return NULL;
#    症状很隐蔽：**中文什么都不显示，而且因为没有"缺字形"所以连占位方块都不画**
#    （LV_USE_FONT_PLACEHOLDER 只管"找不到字形"，管不了"找到但取不到位图"）。
#    压缩版 967 KB vs 不压缩 1036 KB（本字表 @18px）—— 压缩反而更小，所以留着压缩。
#
# 2) LV_FONT_FMT_TXT_LARGE —— 把 glyph_dsc.bitmap_index 从 20 位放宽到 32 位
#    20 位即位图上限 1 MB（src/font/fmt_txt/lv_font_fmt_txt.h）。当前字表 @18px
#    是 967 KB（94.5%），虽然还没撞线，但换个字号/更大的字表立刻就超，而超了
#    lv_font_conv 会在生成的 .c 里埋 `#error`。**一次开掉，以后换字表/加字号都不用再动配置。**
#    代价：glyph_dsc 每个字形从 8 字节变 12 字节 —— 本字体 8763 个字形约 +34 KB；
#    另外 Montserrat 各档也会跟着变宽，合计约 +12 KB。
#
# ⚠️ 这两项在现有 sdkconfig 里已经是 "# ... is not set" 状态，而 defaults 只对
#    "尚未出现"的符号生效 —— **所以改完必须删掉 sdkconfig 重新生成**（见上面那段的说明）。
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y


# ---- USB Host（USB 摄像头 / UVC 需要）----
# 这两项是 UVC 能不能工作的**前提**，不是调优项：
#
# 1) 默认 256 太小。IDF 在 components/usb/Kconfig 里写明
#    "Device's with configuration descriptors larger than this limit cannot be supported"
#    —— UVC 设备的配置描述符（VC + VS 接口 + 格式 + 帧描述符）远超 256 字节，
#    256 会让摄像头**根本枚举不出来**。
# 2) 视频流是 IN 方向。Balanced 的 IN FIFO 只有 408 字节，Bias IN 给到 600
#    （代价是 OUT non-periodic 降到 64 字节，我们用不到 OUT）。
#
# 取值来自 demo1 的 USB 摄像头工程（同一块板实测可用）。
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y

# ---- WiFi（板载 ESP32-C6 协处理器，P4 <-> C6 走 SDIO）----
#
# 取值出处：厂家 brookesia 手机示例的**生成版** sdkconfig
#   esp32p4_research/ESP32-P4-WIFI6-Touch-LCD-7B/examples/ESP-IDF/11_esp_brookesia_phone/sdkconfig:2634-2667 (hosted)
#                                                                    :2773-2800 (wifi_remote)
# 那份 sdkconfig 里同一组配置出现了两次，**前缀不同**：
#   带 ESP_HOSTED_ 前缀的 = 正式符号名（"ESP-Hosted config" 段）
#   不带的（CONFIG_SDIO_*、CONFIG_IDF_SLAVE_TARGET） = 旧名，在 "# End of deprecated options" 段里，不要用
#
# ⚠️ 厂家**没有任何示例**在 sdkconfig.defaults 里写这些 —— 说明 esp_hosted 对
#    ESP32-P4 的默认值本来就是这套接线（和 Espressif P4-Function-EV-Board 一致）。
#    这里显式写出来的目的，是让板级接线在仓库里可见，而不是藏在第三方组件的 Kconfig 默认值里。
#    （万一某个名字写错了，kconfig 会静默忽略该行 -> 退回默认值，不会比不写更差。）
#
# ⚠️ 首次编译后请核对一次（这条链路是"配置错了不报错、只是连不上"的类型）：
#      grep -E "ESP_HOSTED_SDIO_PIN_CLK|ESP_WIFI_REMOTE_ENABLED|SLAVE_IDF_TARGET" sdkconfig
#    期望看到 PIN_CLK=18、REMOTE_ENABLED=y、SLAVE_IDF_TARGET_ESP32C6=y。
#    若没生效：删掉 sdkconfig 重新生成（defaults 只对 sdkconfig 里**尚未出现**的符号生效）。

# --- esp_wifi_remote 总开关：不写这三项，组件装了也不生效 ---
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y

# --- esp_hosted 传输方式：SDIO（P4 的 SDMMC slot 1，走 GPIO 矩阵）---
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y

# --- 接线（注意和 uSD 卡完全不重叠：卡在 slot0 的 IOMUX 39~44 + LDO4）---
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54

# ==================== 临时诊断：SNTP 首次对时偶发要 100+ 秒 ====================
#
# 【已定位并修掉，2026-09-27】结论：丢的是"到 NTP 端点的那一次 UDP 123 交换"，
# 跟设备/链路/校园网都无关 —— 是某些 NTP 端点自己的成功率低（两台独立设备合计：
# aliyun 58% vs 腾讯 95%、pool 90%、cloudflare 85%、ntsc 30%），而 lwip 的
# 15/30/60 秒退避把它放大成 150 秒。修复 = 服务器换成 ntp.tencent.com。
# 完整证据在 components/net_time/net_time_diag.c 顶部 + net_time.c 的
# NET_TIME_SERVER 注释。
#
# ⚠️ 下面三个开关**当前已停用**（都注释掉了）—— 它们只是那次排查的取证手段。
#    要重新启用：取消注释 + **删掉 sdkconfig 重新生成**
#    （defaults 改不了 sdkconfig 里已经存在的符号）。
#    各自能证明什么，留着备查：
#      A. 请求根本没离开 P4（被 esp_hosted 主动限流丢弃）  -> PKT_STATS
#      B. 写 SDIO 失败                                    -> PKT_STATS
#      C. 请求出去了但响应没回来（链路/AP/服务器）        -> PKT_STATS + SNTP_DEBUG
#      D. 响应回来了但被 lwip 拒了                        -> SNTP_DEBUG
#         （D 概率低：IDF 的 SNTP_CHECK_RESPONSE=0，lwip 连源地址都不校验）

# --- 1) esp_hosted 传输层包统计 ---
# 开了之后 esp_hosted 自带一个线程，**每 10 秒**打一行（create_debugging_tasks()
# 在 sdio_drv.c:781 被调用，不需要我们写代码）：
#     I (xx) stats: slave: sta_rx_in: N sta_rx_out: N sta_tx_in [pass: N drop: N] sta_tx_out: N
#     I (xx) stats: wifi_tx_throttling N
# ⚠️ 日志前缀写的是 "slave:"，但这五个其实是**主机侧（P4）SDIO 驱动**的计数器，
#    esp_hosted 这标签起得误导。各自的自增点：
#     sta_tx_in_pass  lwip 交下来的包、通过检查准备发      sdio_drv.c:1134
#     sta_tx_out      真的写到 SDIO 上去了                 sdio_drv.c:502
#     sta_rx_in       从 SDIO 收到了（校验和通过）          sdio_drv.c:559
#     sta_tx_in_drop  **被 host 主动丢弃的**                transport_drv.c:224
# 判据（拿 SNTP 失败的时刻去对增量）：
#     drop 涨 / wifi_tx_throttling=1  -> A：host 主动限流丢的（当前头号嫌疑）
#     pass 涨但 out 不涨              -> B：SDIO 写失败
#     out 涨但 rx_in 不涨             -> C：出去了没回来
# ⚠️ 停用中（要启用先取消注释，再删 sdkconfig 重新生成）
# CONFIG_ESP_HOSTED_PKT_STATS=y

# --- 2) lwip 的 SNTP 调试日志 ---
# LWIP_DEBUG 是总开关（它**不**会顺带打开别的模块），SNTP_DEBUG 单独控制 SNTP。
# 接线已确认：CONFIG_LWIP_SNTP_DEBUG -> SNTP_DEBUG=LWIP_DBG_ON（lwipopts.h:1502）。
# 能看到：每次发出请求、每次重试排期、以及**任何被拒的包**（Invalid mode /
# Invalid packet length / Invalid originate timestamp）。
#
# 注意：这里**故意不设** CONFIG_LWIP_DEBUG_ESP_LOG。
#   设了的话 lwip 的调试会走 `ESP_LOG_LEVEL(ESP_LOG_DEBUG, "lwip", ...)`
#   （port/esp32xx/include/arch/cc.h:62-67），而本工程 CONFIG_LOG_MAXIMUM_LEVEL=3
#   （= INFO），**ESP_LOG_DEBUG 会被整条编译掉 → 一个字都看不到**（比"看不到时间戳"更糟）。
#   不设则走 cc.h 的另一分支 `printf`，一定会出现在串口。
#   代价：这些行**没有时间戳**，要靠"在输出流里的出现顺序"和带时间戳的 `stats:` 行对位。
# ⚠️ 停用中（要启用先取消注释，再删 sdkconfig 重新生成）
# CONFIG_LWIP_DEBUG=y
# CONFIG_LWIP_SNTP_DEBUG=y

